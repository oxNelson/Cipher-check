# Port to run the server on (defaults to 3000)
PORT=3000

# PostgreSQL Connection String (Neon or Cloud SQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Optional SMTP Settings (blocked if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
